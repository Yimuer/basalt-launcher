<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BasaltLauncher3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Basalt 启动器">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid" Background="Transparent" Padding="20,16,20,12" RowSpacing="12">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="OpaqueWindowBrush" Color="#202020" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OpaqueWindowBrush" Color="#F3F3F3" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Basalt 本地引擎" FontSize="20" FontWeight="SemiBold" />

    <Border Grid.Row="1" Padding="14,12" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="StateDot" Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center" Fill="#9A9A9A" />
          <TextBlock x:Name="TxtState" Grid.Column="1" Text="正在检查…" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TxtUptime" Grid.Column="2" Text="" FontSize="12" Opacity="0.72" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="TxtMeta" Text="—" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtMetrics" Text="" FontSize="12" Opacity="0.86" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtHint" Text="" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button x:Name="BtnStart" Content="启动服务" Style="{StaticResource AccentButtonStyle}" Click="OnStartService" />
      <Button x:Name="BtnStop" Content="停止服务" Click="OnStopService" />
      <Button x:Name="BtnWeb" Content="打开 Web UI" Click="OnOpenWeb" />
      <Button x:Name="BtnPanel" Content="监控面板" Click="OnOpenPanel" />
    </StackPanel>

    <Border Grid.Row="3" Padding="14,12" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="主题" VerticalAlignment="Center" />
          <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="跟随系统" Tag="system" IsSelected="True" />
            <ComboBoxItem Content="浅色" Tag="light" />
            <ComboBoxItem Content="深色" Tag="dark" />
          </ComboBox>
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="背景材质" VerticalAlignment="Center" />
          <ComboBox x:Name="BackdropBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnBackdropChanged">
            <ComboBoxItem Content="Mica（默认）" Tag="mica" IsSelected="True" />
            <ComboBoxItem Content="Mica Alt" Tag="micaalt" />
            <ComboBoxItem Content="桌面亚克力" Tag="acrylic" />
            <ComboBoxItem Content="实色（最省电）" Tag="none" />
          </ComboBox>
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="关闭时收进托盘" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OnContent="开" OffContent="关" IsOn="True" />
        </Grid>
        <TextBlock Text="登录 Windows 后" FontSize="13" FontWeight="SemiBold" Opacity="0.8" Margin="0,4,0,0" />
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="自动启动引擎" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="EngineStartSwitch" Grid.Column="1" Tag="BasaltLocalAI" OnContent="开" OffContent="关" Toggled="OnAutostartToggled" />
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="启动器（收进托盘）" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="LauncherStartSwitch" Grid.Column="1" Tag="BasaltLauncher" OnContent="开" OffContent="关" Toggled="OnAutostartToggled" />
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="打开监控面板" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="PanelStartSwitch" Grid.Column="1" Tag="BasaltTrayMonitor" OnContent="开" OffContent="关" Toggled="OnAutostartToggled" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock x:Name="TxtFooter" Grid.Row="5" Text="Basalt  ·  Launcher3 0.1" FontSize="11"
               Opacity="0.55" HorizontalAlignment="Right" />
  </Grid>
</Window>
